# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon / managed Postgres in production).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign/verify JWTs. Use a long, random string in production.
JWT_SECRET="change_me"

# Backend HTTP port (defaults to 3000 when unset).
PORT=3000

# Comma-separated list of allowed browser origins (CORS).
# Include the production frontend URL here (e.g. the Vercel/custom domain).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Mpesa production credentials (required when Mpesa live integration is enabled).
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
