generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MpesaAccount {
  id                String             @id @default(cuid())
  businessId        String
  accountIdentifier String
  displayName       String
  status            MpesaAccountStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  business          Business           @relation(fields: [businessId], references: [id])
  transactions      MpesaTransaction[]

  @@unique([businessId, accountIdentifier])
}

model MpesaTransaction {
  id                    String                 @id @default(cuid())
  businessId            String
  mpesaAccountId        String
  shiftId               String?
  externalTransactionId String
  amount                Decimal
  transactionTime       DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                MpesaTransactionStatus @default(RECEIVED)
  business              Business               @relation(fields: [businessId], references: [id])
  mpesaAccount          MpesaAccount           @relation(fields: [mpesaAccountId], references: [id])
  shift                 Shift?                 @relation(fields: [shiftId], references: [id])

  @@unique([mpesaAccountId, externalTransactionId])
}

model Business {
  id                String             @id @default(cuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  currency          String             @default("KES")
  email             String?
  phone             String?
  timezone          String             @default("Africa/Nairobi")
  branches          Branch[]
  discrepancies     Discrepancy[]
  mpesaAccounts     MpesaAccount[]
  mpesaTransactions MpesaTransaction[]
  products          Product[]
  stockMovements    StockMovement[]    @relation("BusinessStockMovements")
  transfers         Transfer[]
  users             User[]
}

model Branch {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  discrepancies     Discrepancy[]
  expenses          Expense[]
  inventory         InventoryItem[]
  shifts            Shift[]
  stockLocations    StockLocation[]
  movements         StockMovement[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")

  @@unique([businessId, name])
}

model Product {
  id              String               @id @default(cuid())
  name            String
  sellingPrice    Float
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  businessId      String
  inventory       InventoryItem[]
  business        Business             @relation(fields: [businessId], references: [id])
  costHistory     ProductCostHistory[]
  units           ProductUnit[]
  shiftStockItems ShiftStockItem[]
  movements       StockMovement[]
  transferItems   TransferItem[]

  @@unique([businessId, name])
}

model ProductCostHistory {
  id          String   @id @default(cuid())
  productId   String
  costPrice   Float
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
}

model Expense {
  id            String        @id @default(cuid())
  amount        Float
  description   String?
  branchId      String
  createdById   String?
  createdAt     DateTime      @default(now())
  discrepancies Discrepancy[]
  branch        Branch        @relation(fields: [branchId], references: [id])
  createdBy     User?         @relation("UserExpenses", fields: [createdById], references: [id])
}

model ProductUnit {
  id             String          @id @default(cuid())
  productId      String
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  transferItems  TransferItem[]
}

model User {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessId        String
  role              UserRole        @default(WORKER)
  password          String          @default("temporary_password")
  discrepancies     Discrepancy[]   @relation("UserDiscrepancies")
  expensesCreated   Expense[]       @relation("UserExpenses")
  shifts            Shift[]
  stockMovements    StockMovement[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")
  business          Business        @relation(fields: [businessId], references: [id])
}

model InventoryItem {
  id              String         @id @default(cuid())
  quantity        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  branchId        String
  productId       String
  stockLocationId String?
  branch          Branch         @relation(fields: [branchId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])

  @@unique([branchId, productId])
}

model StockMovement {
  id              String         @id @default(cuid())
  quantity        Int
  type            MovementType
  createdAt       DateTime       @default(now())
  branchId        String
  productId       String
  shiftId         String?
  stockLocationId String?
  transferId      String?
  businessId      String
  productUnitId   String
  userId          String?
  discrepancies   Discrepancy[]
  branch          Branch         @relation(fields: [branchId], references: [id])
  business        Business       @relation("BusinessStockMovements", fields: [businessId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit    @relation(fields: [productUnitId], references: [id])
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
  transfer        Transfer?      @relation(fields: [transferId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
}

model StockLocation {
  id        String            @id @default(cuid())
  branchId  String
  name      String
  type      StockLocationType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  inventory InventoryItem[]
  branch    Branch            @relation(fields: [branchId], references: [id])
  movements StockMovement[]
}

model ShiftStockItem {
  id              String   @id @default(cuid())
  shiftId         String
  productId       String
  openingQuantity Int
  addedQuantity   Int?     @default(0)
  closingQuantity Int?     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])
}

model Transfer {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  status           TransferStatus  @default(PENDING)
  notes            String?
  receivedAt       DateTime?
  businessId       String
  dispatchedAt     DateTime?
  receiverBranchId String
  receiverUserId   String?
  senderBranchId   String
  senderUserId     String
  updatedAt        DateTime        @updatedAt
  discrepancies    Discrepancy[]
  stockMovements   StockMovement[]
  business         Business        @relation(fields: [businessId], references: [id])
  receiverBranch   Branch          @relation("ReceiverTransfers", fields: [receiverBranchId], references: [id])
  receiverUser     User?           @relation("ReceiverTransfers", fields: [receiverUserId], references: [id])
  senderBranch     Branch          @relation("SenderTransfers", fields: [senderBranchId], references: [id])
  senderUser       User            @relation("SenderTransfers", fields: [senderUserId], references: [id])
  items            TransferItem[]
}

model TransferItem {
  id            String      @id @default(cuid())
  transferId    String
  productId     String
  productUnitId String
  quantity      Int
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id])
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])
  transfer      Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Discrepancy {
  id              String            @id @default(cuid())
  description     String?
  branchId        String
  shiftId         String?
  transferId      String?
  stockMovementId String?
  expenseId       String?
  createdById     String?
  createdAt       DateTime          @default(now())
  actualValue     Decimal
  businessId      String
  expectedValue   Decimal
  resolution      String?
  sourceReference String            @unique
  status          DiscrepancyStatus @default(OPEN)
  updatedAt       DateTime          @updatedAt
  variance        Decimal
  type            DiscrepancyType
  branch          Branch            @relation(fields: [branchId], references: [id])
  business        Business          @relation(fields: [businessId], references: [id])
  user            User?             @relation("UserDiscrepancies", fields: [createdById], references: [id])
  expense         Expense?          @relation(fields: [expenseId], references: [id])
  shift           Shift?            @relation(fields: [shiftId], references: [id])
  stockMovement   StockMovement?    @relation(fields: [stockMovementId], references: [id])
  transfer        Transfer?         @relation(fields: [transferId], references: [id])

  @@index([businessId, status])
  @@index([branchId, createdAt])
  @@index([shiftId])
}

model Shift {
  id                String             @id @default(cuid())
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  branchId          String
  userId            String
  discrepancies     Discrepancy[]
  mpesaTransactions MpesaTransaction[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  shiftStockItems   ShiftStockItem[]
  movements         StockMovement[]
}

enum MovementType {
  SUPPLIER_DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  ADJUSTMENT
  SHIFT_ADDITION
}

enum UserRole {
  OWNER
  MANAGER
  WORKER
}

enum StockLocationType {
  COUNTER
  STORAGE
}

enum TransferStatus {
  PENDING
  SENDER_CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum MpesaAccountStatus {
  ACTIVE
  INACTIVE
}

enum MpesaTransactionStatus {
  RECEIVED
  RECONCILED
  DISPUTED
}

enum DiscrepancyType {
  STOCK_SHORTAGE
  CASH_SHORTAGE
  MPESA_MISMATCH
  TRANSFER_MISMATCH
  UNCONFIRMED_ADDITION
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}
