generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MpesaAccount {
  id                String             @id @default(cuid())
  businessId        String
  branchId          String
  accountIdentifier String
  displayName       String
  accountType       MpesaAccountType
  status            MpesaAccountStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  business          Business           @relation(fields: [businessId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  transactions      MpesaTransaction[]

  @@unique([businessId, accountIdentifier])
}

model MpesaTransaction {
  id                    String                 @id @default(cuid())
  businessId            String
  branchId              String
  mpesaAccountId        String
  shiftId               String?
  transactionReference  String
  transactionType       MpesaTransactionType
  amount                Decimal
  transactionTime       DateTime
  sender                String?
  receiver              String?
  status                MpesaTransactionStatus @default(RECEIVED)
  reconciliationStatus  MpesaReconciliationStatus @default(UNRECONCILED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id])
  mpesaAccount          MpesaAccount           @relation(fields: [mpesaAccountId], references: [id])
  shift                 Shift?                 @relation(fields: [shiftId], references: [id])

  @@unique([mpesaAccountId, transactionReference])
  @@index([businessId, transactionTime])
  @@index([shiftId])
}

model Business {
  id                String             @id @default(cuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  currency          String             @default("KES")
  email             String?
  phone             String?
  timezone          String             @default("Africa/Nairobi")
  branches          Branch[]
  discrepancies     Discrepancy[]
  mpesaAccounts     MpesaAccount[]
  mpesaTransactions MpesaTransaction[]
  products          Product[]
  stockMovements    StockMovement[]    @relation("BusinessStockMovements")
  stockLocations    StockLocation[]
  transfers         Transfer[]
  userBusinesses    UserBusiness[]
}

model Branch {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  discrepancies     Discrepancy[]
  expenses          Expense[]
  inventory         InventoryItem[]
  shifts            Shift[]
  movements         StockMovement[]
  mpesaAccounts     MpesaAccount[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")
  users             User[]

  @@unique([businessId, name])
}

model Product {
  id              String               @id @default(cuid())
  name            String
  sellingPrice    Float
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  businessId      String
  inventory       InventoryItem[]
  business        Business             @relation(fields: [businessId], references: [id])
  costHistory     ProductCostHistory[]
  units           ProductUnit[]
  shiftStockItems ShiftStockItem[]
  movements       StockMovement[]
  transferItems   TransferItem[]
  discrepancies   Discrepancy[]

  @@unique([businessId, name])
}

model ProductCostHistory {
  id          String   @id @default(cuid())
  productId   String
  costPrice   Float
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
}

model Expense {
  id                  String        @id @default(cuid())
  amount              Float
  description         String?
  branchId            String
  createdById         String?
  status              ExpenseStatus @default(RECORDED)
  acknowledgedByUserId String?
  acknowledgedAt      DateTime?
  createdAt           DateTime      @default(now())
  discrepancies       Discrepancy[]
  branch              Branch        @relation(fields: [branchId], references: [id])
  createdBy           User?         @relation("UserExpenses", fields: [createdById], references: [id])
  acknowledgedBy       User?         @relation("UserAcknowledgedExpenses", fields: [acknowledgedByUserId], references: [id])
}

model ProductUnit {
  id             String          @id @default(cuid())
  productId      String
  name           String
  symbol         String
  quantity       Decimal
  conversionFactor Decimal?
  isDefault      Boolean         @default(false)
  status         ProductUnitStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  transferItems  TransferItem[]
  inventoryItems InventoryItem[]
  shiftStockItems ShiftStockItem[]
}

model User {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  role              UserRole        @default(WORKER)
  status            UserStatus      @default(ACTIVE)
  phone             String?
  email             String?
  password          String          @default("temporary_password")
  branchId          String?
  discrepancies     Discrepancy[]   @relation("UserDiscrepancies")
  expensesCreated   Expense[]       @relation("UserExpenses")
  expensesAcknowledged Expense[]    @relation("UserAcknowledgedExpenses")
  shifts            Shift[]
  stockMovements    StockMovement[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")
  userBusinesses    UserBusiness[]
  branch            Branch?         @relation(fields: [branchId], references: [id])
}

model UserBusiness {
  id         String      @id @default(cuid())
  userId     String
  businessId String
  role       UserRole    @default(WORKER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  business   Business    @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

model InventoryItem {
  id              String         @id @default(cuid())
  quantity        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  branchId        String
  productId       String
  productUnitId   String
  stockLocationId String?
  branch          Branch         @relation(fields: [branchId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit    @relation(fields: [productUnitId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])

  @@unique([branchId, productId, productUnitId])
}

model StockMovement {
  id              String         @id @default(cuid())
  quantity        Int
  type            MovementType
  createdAt       DateTime       @default(now())
  branchId        String
  productId       String
  shiftId         String?
  stockLocationId String?
  transferId      String?
  businessId      String
  productUnitId   String
  userId          String?
  discrepancies   Discrepancy[]
  branch          Branch         @relation(fields: [branchId], references: [id])
  business        Business       @relation("BusinessStockMovements", fields: [businessId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit    @relation(fields: [productUnitId], references: [id])
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
  transfer        Transfer?      @relation(fields: [transferId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
}

model StockLocation {
  id        String            @id @default(cuid())
  businessId String
  name      String
  type      StockLocationType
  description String?
  status    StockLocationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id])
  inventory         InventoryItem[]
  movements         StockMovement[]
  shiftStockItems   ShiftStockItem[]
  receivedTransfers Transfer[]        @relation("ReceiverLocationTransfers")
  sentTransfers     Transfer[]        @relation("SenderLocationTransfers")
  discrepancies     Discrepancy[]
}

model ShiftStockItem {
  id              String   @id @default(cuid())
  shiftId         String
  productId       String
  businessId      String
  branchId        String
  productUnitId   String
  stockLocationId String?
  openingQuantity Int
  addedQuantity   Int      @default(0)
  closingQuantity Int?
  soldQuantity    Int?
  revenue         Decimal?
  cost            Decimal?
  grossProfit     Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])
  productUnit     ProductUnit @relation(fields: [productUnitId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
}

model Transfer {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  status           TransferStatus  @default(PENDING)
  notes            String?
  receivedAt       DateTime?
  businessId       String
  dispatchedAt     DateTime?
  receiverBranchId String
  receiverLocationId String?
  receiverUserId   String?
  senderBranchId   String
  senderLocationId String?
  senderUserId     String
  updatedAt        DateTime        @updatedAt
  discrepancies    Discrepancy[]
  stockMovements   StockMovement[]
  business         Business        @relation(fields: [businessId], references: [id])
  receiverBranch   Branch          @relation("ReceiverTransfers", fields: [receiverBranchId], references: [id])
  receiverLocation StockLocation?  @relation("ReceiverLocationTransfers", fields: [receiverLocationId], references: [id])
  receiverUser     User?           @relation("ReceiverTransfers", fields: [receiverUserId], references: [id])
  senderBranch     Branch          @relation("SenderTransfers", fields: [senderBranchId], references: [id])
  senderLocation   StockLocation?  @relation("SenderLocationTransfers", fields: [senderLocationId], references: [id])
  senderUser       User            @relation("SenderTransfers", fields: [senderUserId], references: [id])
  items            TransferItem[]
}

model TransferItem {
  id            String      @id @default(cuid())
  transferId    String
  productId     String
  productUnitId String
  quantity      Int
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id])
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])
  transfer      Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Discrepancy {
  id              String            @id @default(cuid())
  description     String?
  branchId        String
  shiftId         String?
  transferId      String?
  stockMovementId String?
  expenseId       String?
  productId       String?
  locationId       String?
  createdById     String?
  createdAt       DateTime          @default(now())
  actualValue     Decimal
  businessId      String
  expectedValue   Decimal
  expectedQuantity Int?
  actualQuantity   Int?
  quantityDifference Int?
  resolution      String?
  sourceReference String            @unique
  status          DiscrepancyStatus @default(OPEN)
  updatedAt       DateTime          @updatedAt
  variance        Decimal
  type            DiscrepancyType
  branch          Branch            @relation(fields: [branchId], references: [id])
  business        Business          @relation(fields: [businessId], references: [id])
  user            User?             @relation("UserDiscrepancies", fields: [createdById], references: [id])
  expense         Expense?          @relation(fields: [expenseId], references: [id])
  shift           Shift?            @relation(fields: [shiftId], references: [id])
  stockMovement   StockMovement?    @relation(fields: [stockMovementId], references: [id])
  transfer        Transfer?         @relation(fields: [transferId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])
  location         StockLocation?    @relation(fields: [locationId], references: [id])

  @@index([businessId, status])
  @@index([branchId, createdAt])
  @@index([shiftId])
}

model Shift {
  id                String             @id @default(cuid())
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  branchId          String
  userId            String
  discrepancies     Discrepancy[]
  mpesaTransactions MpesaTransaction[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  shiftStockItems   ShiftStockItem[]
  movements         StockMovement[]
}

enum MovementType {
  SUPPLIER_DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  ADJUSTMENT
  SHIFT_ADDITION
}

enum UserRole {
  OWNER
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockLocationType {
  COUNTER
  STORAGE
}

enum StockLocationStatus {
  ACTIVE
  INACTIVE
}

enum TransferStatus {
  PENDING
  SENDER_CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum MpesaAccountStatus {
  ACTIVE
  INACTIVE
}

enum MpesaAccountType {
  PAYBILL
  POCHI
  BUY_GOODS_AND_SERVICES
  SEND_MONEY
}

enum MpesaTransactionType {
  PAYBILL
  POCHI
  BUY_GOODS_AND_SERVICES
  SEND_MONEY
}

enum MpesaTransactionStatus {
  RECEIVED
  RECONCILED
  DISPUTED
}

enum MpesaReconciliationStatus {
  UNRECONCILED
  RECONCILED
}

enum DiscrepancyType {
  STOCK_SHORTAGE
  CASH_SHORTAGE
  MPESA_MISMATCH
  TRANSFER_MISMATCH
  UNCONFIRMED_ADDITION
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

enum ProductUnitStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseStatus {
  RECORDED
  ACKNOWLEDGED
}
